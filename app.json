{
  "expo": {
    "name": "Weave",
    "slug": "weave",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "weave",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hetanb.weave"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Weave uses your microphone so you can talk through what's on your mind.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ]
  }
}
